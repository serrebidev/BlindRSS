#: core/announcements.py:145
msgid "Filter change"
msgstr "Zmiana filtra"

#: core/announcements.py:146
msgid "Announce the applied article filter (Ctrl+1 to Ctrl+6)."
msgstr "Odczytuj zastosowany filtr artykułów (Ctrl+1 do Ctrl+6)."

#: core/announcements.py:147
msgid "Read/unread status change"
msgstr "Zmiana stanu przeczytania"

#: core/announcements.py:148
msgid "Announce the new status when toggling read/unread (Backspace)."
msgstr "Odczytuj nowy stan przy przełączaniu przeczytania (Backspace)."

#: core/announcements.py:149
msgid "Start update"
msgstr "Rozpoczęcie aktualizacji"

#: core/announcements.py:150
msgid "Announce when a feed refresh is started (F5)."
msgstr "Odczytuj rozpoczęcie aktualizacji kanałów (F5)."

#: core/announcements.py:151
msgid "Stop update"
msgstr "Zatrzymanie aktualizacji"

#: core/announcements.py:152
msgid "Announce when a feed refresh is stopped (Shift+F5)."
msgstr "Odczytuj zatrzymanie aktualizacji kanałów (Shift+F5)."

#: core/announcements.py:153
msgid "Favorites change"
msgstr "Zmiana ulubionych"

#: core/announcements.py:154
msgid ""
"Announce when an article is added to or removed from favorites (Ctrl+D)."
msgstr ""
"Odczytuj, gdy artykuł zostanie dodany do ulubionych lub z nich usunięty "
"(Ctrl+D)."

#: core/announcements.py:155
msgid "Playback speed change"
msgstr "Zmiana prędkości odtwarzania"

#: core/announcements.py:156
msgid "Announce the current playback speed when it is changed by keyboard."
msgstr "Odczytuj bieżącą prędkość odtwarzania przy zmianie z klawiatury."

#: core/announcements.py:157
msgid "Media and chapter navigation"
msgstr "Nawigacja po mediach i rozdziałach"

#: core/announcements.py:158
msgid "Announce the item or chapter when moving to the next/previous one."
msgstr ""
"Odczytuj element lub rozdział przy przejściu do następnego/poprzedniego."

#: core/announcements.py:159
msgid "SponsorBlock skip"
msgstr "Pominięcie SponsorBlock"

#: core/announcements.py:160
msgid "Announce when a sponsor or other SponsorBlock segment is skipped."
msgstr ""
"Odczytuj, gdy zostanie pominięty sponsor albo inny fragment SponsorBlock."

#: core/announcements.py:161
msgid "Other notifications"
msgstr "Inne powiadomienia"

#: core/announcements.py:162
msgid "Announce other significant interface changes and notifications."
msgstr "Odczytuj inne istotne zmiany interfejsu i powiadomienia."

