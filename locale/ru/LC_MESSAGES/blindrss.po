msgid "Start BlindRSS in the system tray"
msgstr "Запускать BlindRSS в области уведомлений"

#: gui/dialogs.py:1304
msgid "Always start maximized"
msgstr "Всегда запускать в развёрнутом виде"

#: gui/dialogs.py:1308
