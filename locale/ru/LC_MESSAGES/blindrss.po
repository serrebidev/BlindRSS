msgstr "Вставьте полный URL из адресной строки вашего браузера"

#: gui/dialogs.py:2595 gui/dialogs.py:3005
msgid "System Default"
msgstr "Установленная в системе по умолчанию"

#: gui/dialogs.py:2706
msgid "Playback cache"
msgstr "Кэш воспроизведения"

#: gui/dialogs.py:2779
msgid ""
"No recent YouTube cookies.txt export was found in your Downloads.\n"
"\n"
"Export one with the extension first, or choose the file manually."
msgstr ""
"В ваших загрузках не найден ни один недавно экспортированный cookies.txt от "
"YouTube.\n"
"\n"
"Сначала экспортируйте его при помощи расширения, или выберите файл вручную."

#: gui/dialogs.py:2783
msgid "No export found"
msgstr "Экспорт не найден"

#: gui/dialogs.py:2786
